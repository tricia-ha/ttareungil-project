KAKAO_REST_API_KEY=
KMA_API_KEY=
SEOUL_API_KEY=
# 선택: create_profile()이 발급한 본인 ID. 비우면 기존 모델 그대로 사용합니다.
BICYCLE_PERSONALIZATION_ID=
# 개인 이력의 단측 95% t 예측 상한. 비워도 기본 초과율 0.05를 사용합니다.
PERSONALIZATION_HISTORY_ALPHA=0.05
PERSONALIZATION_HISTORY_METHOD=student_t
# active: 상한 초과 기록을 개인화 갱신에서 제외. shadow: 진단만 저장.
PERSONALIZATION_HISTORY_MODE=active

# 웹 서버: 작업당 새 도보 호출 상한. 기존 일일 안전한도는 유지합니다.
WEB_MAX_KAKAO_CALLS=20
# 사용자 도메인이 있다면 호스트 이름만 쉼표로 구분합니다.
WEB_ALLOWED_HOSTS=
# ngrok 고정 주소는 ngrok_설정.cmd로 등록합니다. 별도 도메인 구매 불필요.
